generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  privyDid  String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orgs      OrgMember[]
  sessions  OAuthSession[]
}

model Org {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  personal  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   OrgMember[]
  sessions  OAuthSession[]
  deviceCodes DeviceCode[]
  charges   BillingCharge[]
  debits    BillingDebit[]
  apiKeys   ApiKey[]
  agents    AgentInstance[]

  /// Top-up / purchased credit balance (decimal STRING, never float).
  balanceUsd String @default("0")
  /// Free monthly allowance remaining (decimal STRING).
  subscriptionCreditsUsd String @default("0.10")
  /// Spent this billing period (decimal STRING).
  spentThisPeriodUsd String @default("0")
  /// free | plus | super | ultra
  subscriptionTierId   String    @default("free")
  subscriptionTierName String    @default("Free")
  cycleEndsAt         DateTime?
  lastTopupAt         DateTime?
  cliBillingEnabled   Boolean @default(true)
  stripeCustomerId    String?
  stripeDefaultPmId   String?
  stripeSubscriptionId String?
  cardBrand           String?
  cardLast4           String?
  /// Scheduled downgrade (chargeless; applied at period end via Stripe schedule / webhook).
  pendingDowngradeTierId   String?
  pendingDowngradeTierName String?
  pendingDowngradeAt        DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)
  autoReloadEnabled   Boolean @default(false)
  autoReloadThresholdUsd String?
  autoReloadAmountUsd    String?
  monthlyCapUsd   String?
  monthlySpentUsd String  @default("0")
}

/// Inference / metered spend (subscription credits first, then purchased).
/// Token fields come from OpenRouter usage on the same settle (Hermes Usage cards).
model BillingDebit {
  id                    String   @id @default(cuid())
  orgId                 String
  org                   Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountUsd             String
  subscriptionTakenUsd  String
  purchasedTakenUsd     String
  idempotencyKey        String
  purpose               String?
  /// OpenRouter usage.prompt_tokens
  inputTokens           Int      @default(0)
  /// OpenRouter usage.completion_tokens
  outputTokens          Int      @default(0)
  /// OpenRouter usage.prompt_tokens_details.cached_tokens
  cacheReadTokens       Int      @default(0)
  /// OpenRouter usage.prompt_tokens_details.cache_write_tokens
  cacheWriteTokens      Int      @default(0)
  createdAt             DateTime @default(now())

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt])
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   String @default("OWNER")
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model DeviceCode {
  id              String    @id @default(cuid())
  deviceCodeHash  String    @unique
  userCode        String    @unique
  clientId        String
  scope           String
  orgId           String?
  org             Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  approvedUserId  String?
  status          String    @default("pending")
  expiresAt       DateTime
  intervalSeconds Int       @default(1)
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
}

model OAuthSession {
  id               String    @id @default(cuid())
  orgId            String
  userId           String
  clientId         String
  scope            String
  refreshTokenHash String    @unique
  accessJti        String?
  expiresAt        DateTime
  lastActiveAt     DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, revokedAt])
  @@index([userId, revokedAt])
}

/// Short-lived authorization codes for agent dashboard OAuth (PKCE).
model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  redirectUri         String
  scope               String
  orgId               String
  userId              String
  agentInstanceId     String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([clientId, consumedAt])
  @@index([agentInstanceId])
}

/// Static Portal inference keys (`sk-work4you-…`).
/// `keyHash` for auth; `keyEnc` (AES-GCM) so owners can copy again (Hermes).
model ApiKey {
  id             String    @id @default(cuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String    @default("Chave de API")
  /// SHA-256 hex of the full secret.
  keyHash        String    @unique
  /// AES-GCM ciphertext (base64url) of the secret for owner reveal/copy.
  keyEnc         String?
  /// Display prefix e.g. sk-work4you-Ab12…x9Qz
  keyPrefix      String
  totalSpentUsd  String    @default("0")
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId, revokedAt])
}

/// Hosted Work4You Cloud agent VM (one Fly app per instance).
/// Desktop discovery DTO: GET /api/agents → { id, name, status, dashboardUrl, dashboardGatewayState }.
model AgentInstance {
  id                     String    @id @default(cuid())
  orgId                  String
  org                    Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Display name (Hermes Create modal).
  name                   String
  /// URL-safe unique slug → Fly app `w4y-agent-<slug>`.
  slug                   String    @unique
  /// small | medium | large
  size                   String    @default("small")
  /// Preferred model id (informational; agent config may mirror later).
  model                  String?
  /// provisioning | starting | online | stopped | error | deleting
  status                 String    @default("provisioning")
  flyAppName             String?   @unique
  flyMachineId           String?
  flyVolumeId            String?
  flyRegion              String    @default("gru")
  dashboardUrl           String?
  /// active | degraded | down | unknown
  dashboardGatewayState  String    @default("unknown")
  errorMessage           String?
  cpus                   Int       @default(2)
  memoryMb               Int       @default(1024)
  diskGb                 Int       @default(10)
  maxSessions            Int       @default(5)
  /// Estimated running $/day (display only).
  priceRunningUsd        String    @default("0")
  /// Estimated stopped/storage $/day (display only).
  priceStoppedUsd        String    @default("0")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  startedAt              DateTime?
  stoppedAt              DateTime?
  /// OAuth session id for the bootstrap `work4you-cli-vps` credential.
  bootstrapSessionId     String?
  /// Optional drain secret for scale-to-zero webhook auth.
  dashboardDrainSecret   String?

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([bootstrapSessionId])
}

/// One top-up charge (CLI poll contract).
model BillingCharge {
  id               String   @id @default(cuid())
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountUsd        String
  status           String   @default("pending") // pending | settled | failed
  reason           String?
  idempotencyKey   String
  stripePaymentIntentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status])
}

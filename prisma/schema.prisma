generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  privyDid  String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orgs      OrgMember[]
  sessions  OAuthSession[]
}

model Org {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  personal  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   OrgMember[]
  sessions  OAuthSession[]
  deviceCodes DeviceCode[]
  charges   BillingCharge[]
  debits    BillingDebit[]

  /// Top-up / purchased credit balance (decimal STRING, never float).
  balanceUsd String @default("0")
  /// Free monthly allowance remaining (decimal STRING).
  subscriptionCreditsUsd String @default("0.10")
  /// Spent this billing period (decimal STRING).
  spentThisPeriodUsd String @default("0")
  /// free | plus | super | ultra
  subscriptionTierId   String    @default("free")
  subscriptionTierName String    @default("Free")
  cycleEndsAt         DateTime?
  lastTopupAt         DateTime?
  cliBillingEnabled   Boolean @default(true)
  stripeCustomerId    String?
  stripeDefaultPmId   String?
  stripeSubscriptionId String?
  cardBrand           String?
  cardLast4           String?
  /// Scheduled downgrade (chargeless; applied at period end via Stripe schedule / webhook).
  pendingDowngradeTierId   String?
  pendingDowngradeTierName String?
  pendingDowngradeAt        DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)
  autoReloadEnabled   Boolean @default(false)
  autoReloadThresholdUsd String?
  autoReloadAmountUsd    String?
  monthlyCapUsd   String?
  monthlySpentUsd String  @default("0")
}

/// Inference / metered spend (subscription credits first, then purchased).
model BillingDebit {
  id                    String   @id @default(cuid())
  orgId                 String
  org                   Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountUsd             String
  subscriptionTakenUsd  String
  purchasedTakenUsd     String
  idempotencyKey        String
  purpose               String?
  createdAt             DateTime @default(now())

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt])
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   String @default("OWNER")
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model DeviceCode {
  id              String    @id @default(cuid())
  deviceCodeHash  String    @unique
  userCode        String    @unique
  clientId        String
  scope           String
  orgId           String?
  org             Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  approvedUserId  String?
  status          String    @default("pending")
  expiresAt       DateTime
  intervalSeconds Int       @default(1)
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
}

model OAuthSession {
  id               String    @id @default(cuid())
  orgId            String
  userId           String
  clientId         String
  scope            String
  refreshTokenHash String    @unique
  accessJti        String?
  expiresAt        DateTime
  lastActiveAt     DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, revokedAt])
  @@index([userId, revokedAt])
}

/// One top-up charge (CLI poll contract).
model BillingCharge {
  id               String   @id @default(cuid())
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountUsd        String
  status           String   @default("pending") // pending | settled | failed
  reason           String?
  idempotencyKey   String
  stripePaymentIntentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status])
}
